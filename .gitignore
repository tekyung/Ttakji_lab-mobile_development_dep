# Visual Studio 임시 폴더 (여기가 핵심입니다!)
.vs/

bin/
obj/

# 유니티 기본 폴더 무시
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]serSettings/

# 유니티 크래시 복구본 — 에디터가 자동으로 남기는 씬 백업이라 소스가 아니다.
/Assets/_Recovery/
/Assets/_Recovery.meta

# Visual Studio 프로젝트 파일들
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# 유니티 에디터 설정 및 캐시
.DS_Store
sysinfo.txt
*.apk
*.unitypackage

# OS 관련 임시 파일
Thumbs.db
ehthumbs.db
Desktop.ini

# 사용자 지정 경로
GameDesign/SubTool/ExcelToJsonConverter/dev/build/ExcelToJsonConverter/localpycs
GameDesign/SubTool/ExcelToJsonConverter/dev/__pycache__
GameDesign/Storage/SampleData/~$*
Logs
Logs
UserSettings/Search.settings
UserSettings/Layouts/default-6000.dwlt
Logs/shadercompiler-AssetImportWorker0-0.log

# ─── 외부 의존성 관리자(EDM4U)가 만드는 것들 ──────────────────────────
# 파이어베이스 의존성에서 자동 생성된다. GeneratedLocalRepo만 23MB라
# 이력에 넣으면 클론이 무거워진다. 프로젝트를 열면 리졸버가 다시 만든다.
/Assets/GeneratedLocalRepo/
/Assets/GeneratedLocalRepo.meta
/ProjectSettings/AndroidResolverDependencies.xml

# google-services.json 에서 다시 만들어진다(그 파일은 저장소에 있다).
/Assets/Plugins/Android/FirebaseApp.androidlib/
/Assets/Plugins/Android/FirebaseApp.androidlib.meta

# ★ Assets/Plugins/Android 의 gradle 템플릿 3종은 <b>지우지 말 것</b>.
#   Player Settings에서 켜야만 생기는 프로젝트 소스이고,
#   android.useAndroidX 같은 빌드 설정을 담고 있다. 무시하면 다른 사람이 받았을 때
#   안드로이드 빌드 설정이 통째로 사라진다.
#   (리졸버가 그 안의 "Android Resolver ... Start/End" 구간만 다시 쓴다)

# ─── AI 도구 작업 폴더 ────────────────────────────────────────────────
# 사람마다 다르고 용량도 크다. 단 .mcp.json은 팀이 공유하므로 커밋한다.
/.agents/
/.cursor/
/.claude/
/skills-lock.json
