        "effects": [
            {
                "id": "cond_branch",
                "args": {
                    "condition": {
                        "type": "HandCount",
                        "params": {
                            "target": "opponent",
                            "operator": "Greater",
                            "value": "activePlayer.Hand.CountInclusive"
                        }
                    },
                    "successEffectId": "draw_2",
                    "failEffectId": "discard"
                }
            }
        ]
    },
