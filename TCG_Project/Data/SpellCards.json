    {
        "id": "c_snipe",
        "name": "저격",
        "cost": 2,
        "description": "상대 패의 카드 1장을 골라 파괴합니다.",
        "playCondition": "opponent.Hand.Count > 0",
        "effects": [
            {
                "type": "MoveCard",
                "params": {
                    "src": "Hand",
                    "dest": "Graveyard",
                    "target": {
                        "controller": "opponent",
                        "zones": [ "Hand" ],
                        "mode": "Manual", // <--- 직접 선택, 봇은 랜덤
                        "count": 1
                    }
                }
            }
        ]
    },
    {
        "id": "c_discount",
        "name": "마력 축적",
        "cost": 1,
        "description": "내 패에 있는 모든 카드의 코스트를 1 줄입니다.",
        "playCondition": "activePlayer.Hand.Count >= 2",
        "effects": [
            {
                "type": "ModifyStat",
                "params": {
                    "stat": "Cost",
                    "amount": -1,
                    "target": {
                        "controller": "Self",
                        "zones": [ "Hand" ],
                        //"filter": "target.Cost >= 4", 원래 효과는 4코 이상만 감소
                        "mode": "All"
                    }
                }
            }
        ]
    },
    {
        "id": "c_replaceHand",
        "name": "새로운 시작",
        "cost": 3,
        "description": "내 패를 2장 버리고 같은 수만큼 뽑습니다.",
        "playCondition": "activePlayer.Hand.Count >= 3",
        "effects": [
            {
                "type": "MoveCard",
                "params": {
                    "src": "Hand",
                    "dest": "Graveyard",
                    "target": {
                        "controller": "Self",
                        "zones": [ "Hand" ],
                        "mode": "Manual", // 봇은 랜덤
                        "count": 2
                    }
                }
            },
            {
                "id": "draw",
                "args": { "count": 2 }
            }
        ]
    },
    {
        "id": "c_sacrifice_for_mana",
        "name": "마나 변환",
        "cost": 0,
        "description": "내 패를 1장 골라 버리고 마나를 3 회복합니다.",
        "playCondition": "activePlayer.Hand.Count > 1",
        "effects": [
            {
                "type": "MoveCard",
                "params": {
                    "src": "Hand",
                    "dest": "Graveyard",
                    "target": {
                        "controller": "Self",
                        "zones": [ "Hand" ],
                        "mode": "Manual",
                        "count": 1
                    }
                }
            },
            {
                "id": "managain",
                "args": {
                    "target": "ActivePlayer",
                    "amount": 3
                }
            }
        ]
    },
